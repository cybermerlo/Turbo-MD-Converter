# Copia questo file in `.env` (solo per sviluppo da sorgente).
# In produzione le chiavi si inseriscono in Impostazioni e finiscono in
# %APPDATA%\OCRLangExtract\config.json.

# OCR e descrizione visiva dei video (OBBLIGATORIA)
GEMINI_API_KEY=your-api-key-here

# Trascrizione audio/note vocali — ElevenLabs Scribe v2 (opzionale)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Estrazione strutturata LangExtract (opzionale; default = GEMINI_API_KEY)
LANGEXTRACT_API_KEY=your-api-key-here
